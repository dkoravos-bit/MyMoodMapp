legacy-peer-deps=true

# Force ajv v8 everywhere — resolves "Cannot find module 'ajv/dist/compile/codegen'"
# which occurs when schema-utils / ajv-keywords pull in a nested ajv@6.
# npm overrides (npm >= 8.3) enforce this at install time without touching package.json.
overrides[ajv]=^8.0.0
overrides[ajv-keywords]=^5.0.0
